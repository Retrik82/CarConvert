OPENROUTER_API_KEY=your_key_here
PORT=3001
CORS_ORIGINS=http://localhost:5173,*
# Локально (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/carconvert.db
UPLOAD_DIR=./data/uploads
# Production на Render: DATABASE_URL и UPLOAD_DIR задаются в render.yaml
# (Postgres carconvert-db + persistent disk /var/data/uploads)
# Пример Postgres URL для справки:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
JWT_SECRET=change_me_to_random_32_char_string_minimum
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_LOGIN_WINDOW_SEC=60
AUTH_RATE_LIMIT_REFRESH_MAX=30
AUTH_RATE_LIMIT_REFRESH_WINDOW_SEC=60
PASSWORD_RESET_EXPIRE_HOURS=24
HINT_MODEL=rekaai/reka-edge
PROCESS_MODEL=google/gemini-3.1-flash-image-preview
HINT_TIMEOUT_SEC=15
PROCESS_TIMEOUT_SEC=120
MAX_PREVIEW_BYTES=512000
