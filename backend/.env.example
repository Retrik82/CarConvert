OPENROUTER_API_KEY=your_key_here
PORT=3001
CORS_ORIGINS=http://localhost:5173,*
# Локально (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./data/carconvert.db
UPLOAD_DIR=./data/uploads
# Production на Render: DATABASE_URL и UPLOAD_DIR задаются в render.yaml
# Redis — rate limiting; optional ARQ worker when USE_ARQ_WORKER=1
# REDIS_URL=redis://localhost:6379
# USE_ARQ_WORKER=0
JWT_SECRET=change_me_to_random_32_char_string_minimum
JWT_ACCESS_EXPIRE_MIN=15
JWT_REFRESH_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_LOGIN_WINDOW_SEC=60
AUTH_RATE_LIMIT_REFRESH_MAX=30
AUTH_RATE_LIMIT_REFRESH_WINDOW_SEC=60
PASSWORD_RESET_EXPIRE_HOURS=24

# Legacy aliases (still supported)
HINT_MODEL=rekaai/reka-edge
PROCESS_MODEL=google/gemini-3.1-flash-image-preview

# Hints (camera)
HINT_MODEL_PRIMARY=rekaai/reka-edge
HINT_MODEL_FALLBACK=google/gemini-2.5-flash-lite

# Pose / angle
POSE_MODEL=google/gemini-2.5-flash-lite
POSE_MODEL_FALLBACK=rekaai/reka-edge
POSE_TIMEOUT_SEC=10

# Cutout
CUTOUT_MODEL=google/gemini-2.5-flash-image
CUTOUT_MODEL_FALLBACK=google/gemini-3.1-flash-image-preview

# Composite
COMPOSITE_MODEL=google/gemini-3.1-flash-image-preview
COMPOSITE_MODEL_FALLBACK=google/gemini-2.5-flash-image
COMPOSITE_MODEL_PREMIUM=google/gemini-3-pro-image-preview

HINT_TIMEOUT_SEC=15
PROCESS_TIMEOUT_SEC=120
MAX_PREVIEW_BYTES=512000

# Load limits
HINT_MAX_CONCURRENT=8
PROCESS_MAX_CONCURRENT=3
OPENROUTER_MAX_RETRIES=2
PROCESS_JOB_DEADLINE_SEC=300
MAX_QUEUE_SIZE=50
MAX_ACTIVE_JOBS_PER_USER=2
PHOTO_RATE_LIMIT_MAX=10
PHOTO_RATE_LIMIT_WINDOW_SEC=60
